---
import Base from '../layouts/Base.astro';

const links = [
  { num: '01', name: 'Handshake', href: 'https://handshake.org/' },
  { num: '02', name: 'GitHub', href: 'https://github.com/Xnye' },
  { num: '03', name: 'Email', href: 'mailto:2010983680@qq.com' },
];
---

<Base title="0x000B10G" index="01" label="Index">
  <section class="hero">
    <h1 class="hero__name reveal">
      0x000B10G<span class="slash"> /</span>
    </h1>

    <p class="hero__line reveal">
      A quiet place to keep things I do not want to forget.
    </p>

    <div class="hero__meta hud reveal">
      <span>Est. 2025</span>
      <span>Somewhere on the internet</span>
    </div>

    <nav class="links reveal" aria-label="Elsewhere">
      {
        links.map((link) => (
          <a
            class="link"
            href={link.href}
            target={link.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          >
            <span class="link__label">
              <span class="link__num hud">{link.num}</span>
              <span class="link__name">{link.name}</span>
            </span>
            <svg
              class="link__arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        ))
      }
    </nav>
  </section>
</Base>
